# Where a run mints credentials of its own, since the ones it is started with
# lapse while it is still reading. The token itself is held by the platform as a
# secret named DHCORE_PERSONAL_ACCESS_TOKEN, and never lands here. These are the
# same two the dataset repository's own .env carries.
DHCORE_ISSUER=https://core.your-digitalhub-endpoint
DHCORE_CLIENT_ID=

# Where a run is tracked on Weights & Biases. The entity and the project are
# forwarded to a platform run; the key is held by the platform as a secret named
# WANDB_API_KEY, and is read from here by a run on this machine alone.
WANDB_ENTITY=
WANDB_PROJECT=
WANDB_API_KEY=
